<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="monetag" content="7683de6996b74b051cd9c7f54c990ea2">
<script
  src="https://libtl.com/sdk.js"
  data-zone="11988035"
  data-sdk="show_11988035">
</script>
<title>Speaksly Translator</title>

<style>
*{
  box-sizing:border-box;
  font-family:Arial,sans-serif;
}

body{
  margin:0;
  background:#f1f6fa;
  color:#111;
}

.app{
  max-width:100vw;
  margin:auto;
  min-height:100vh;
  padding:18px;
}

header{
  display:flex;
  justify-content:space-between;
  align-items:center;
  margin-bottom:16px;
}

.logo{
  font-size:25px;
  font-weight:900;
  font-style:italic;
}
.logo span{
  font-size:30px;
  font-weight:990;
}
.bell{
  width:42px;
  height:42px;
  border-radius:50%;
  background:white;
  display:flex;
  align-items:center;
  justify-content:center;
  box-shadow:0 3px 12px #0001;
}

.search{
  background:white;
  border-radius:15px;
  padding:12px;
  display:flex;
  gap:10px;
  align-items:center;
  margin-bottom:15px;
}

.search input{
  border:0;
  outline:0;
  width:100%;
  font-size:15px;
}

.hero{
  background:#f1f6fa;
  background-image:url("/language translator /1baa0fa5d7d32b141ea0ab463559a768.jpg");
  border-radius:22px;
  padding:20px;
  margin-bottom:15px;
}

.hero h2{
  margin:0 0 8px;
  font-style:italic;
}

.hero p{
  color:#777;
  margin:0 0 15px;
}

.start{
  border:0;
  padding:14px 22px;
  border-radius:22px;
  background:#7654e8;
  color:white;
  font-weight:bold;
}

.languages{
  display:flex;
  align-items:center;
  gap:8px;
  margin:15px 0;
}

.lang{
  flex:1;
  background:white;
  border-radius:15px;
  padding:13px;
  border:0;
  outline:0;
}

.swap{
  width:43px;
  height:43px;
  border-radius:50%;
  border:1px solid #ddd;
  background:white;
  font-size:20px;
}

.card{
  background:white;
  border-radius:22px;
  padding:15px;
  margin-bottom:15px;
}

textarea{
  width:100%;
  height:130px;
  border:0;
  outline:0;
  resize:none;
  font-size:18px;
  padding:10px;
}

.actions{
  display:flex;
  justify-content:space-between;
  align-items:center;
  border-top:1px solid #eee;
  padding-top:10px;
}

.iconBtn{
  width:45px;
  height:45px;
  border:0;
  border-radius:50%;
  background:#f3f5f7;
  font-size:20px;
}

.translateBtn{
  width:100%;
  margin-top:12px;
  padding:15px;
  border:0;
  border-radius:15px;
  background:#7654e8;
  color:white;
  font-size:17px;
  font-weight:bold;
}

.result{
  min-height:130px;
  font-size:18px;
  line-height:1.5;
  padding:10px;
  white-space:pre-wrap;
}

.voice{
  text-align:center;
  padding:15px;
}

.wave{
  font-size:25px;
  letter-spacing:5px;
  margin:10px;
}

.status{
  text-align:center;
  color:#777;
  font-size:14px;
  min-height:20px;
}
</style>
</head>

<body>

<div class="app">

<header>
  <div class="logo">Speak<span>sly</span></div>
  <div class="bell">🔔</div>
</header>

<div class="search">
  🔍
  <input id="search" placeholder="Search language...">
</div>

<div class="hero">
  <h2>Understand Any Language Instantly!</h2>
  <p>Translate text and voice quickly between languages.</p>
  <button class="start" onclick="focusText()">Start Exploring</button>
</div>

<div class="languages">

<select id="from" class="lang">
  <option value="en">🇬🇧 English</option>
  <option value="hi">🇮🇳 Hindi</option>
  <option value="ar">🇸🇦 Arabic</option>
  <option value="es">🇪🇸 Spanish</option>
  <option value="fr">🇫🇷 French</option>
  <option value="de">🇩🇪 German</option>
  <option value="it">🇮🇹 Italian</option>
  <option value="pt">🇧🇷 Portuguese</option>
  <option value="ru">🇷🇺 Russian</option>
  <option value="ja">🇯🇵 Japanese</option>
  <option value="ko">🇰🇷 Korean</option>
  <option value="zh">🇨🇳 Chinese</option>
</select>

<button class="swap" onclick="swapLang()">⇄</button>

<select id="to" class="lang">
  <option value="hi">🇮🇳 Hindi</option>
  <option value="en">🇬🇧 English</option>
  <option value="ar">🇸🇦 Arabic</option>
  <option value="es">🇪🇸 Spanish</option>
  <option value="fr">🇫🇷 French</option>
  <option value="de">🇩🇪 German</option>
  <option value="it">🇮🇹 Italian</option>
  <option value="pt">🇧🇷 Portuguese</option>
  <option value="ru">🇷🇺 Russian</option>
  <option value="ja">🇯🇵 Japanese</option>
  <option value="ko">🇰🇷 Korean</option>
  <option value="zh">🇨🇳 Chinese</option>
</select>

</div>

<div class="card">

<textarea id="input"
placeholder="Enter text here..."></textarea>

<div class="actions">

<button class="iconBtn" onclick="startMic()">🎤</button>

<button class="iconBtn" onclick="clearText()">✕</button>

</div>

<button class="translateBtn" onclick="translateWithAd()">
  Translate
</button>

</div>

<div class="status" id="status"></div>

<div class="card">

<div class="result" id="result">
Your translation will appear here...
</div>

<div class="actions">

<button class="iconBtn" onclick="speakText()">🔊</button>

<button class="iconBtn" onclick="copyText()">📋</button>

</div>

</div>

<div class="card voice">

<h2>Voice Translator</h2>

<p>Speak and translate instantly</p>

<div class="wave">〰〰〰〰〰</div>

<button class="iconBtn" onclick="startMic()">🎤</button>

</div>

</div>


<script>

const input = document.getElementById("input");
const result = document.getElementById("result");
const from = document.getElementById("from");
const to = document.getElementById("to");
const statusText = document.getElementById("status");

let translating = false;

// Translate button: Rewarded ad, then translation

async function translateWithAd() {
  if (translating) return;

  if (!input.value.trim()) {
    alert("Please enter some text");
    return;
  }

  if (typeof show_11988035 !== "function") {
    statusText.textContent = "Ad SDK load nahi hua.";
    return;
  }

  translating = true;
  statusText.textContent = "Loading rewarded video...";

  try {
    await show_11988035({
      type: "end",
      catchIfNoFeed: true,
      requestVar: "translate_button"
    });

    await translateText();

  } catch (error) {
    console.error("Rewarded video error:", error);
    statusText.textContent =
      "Video ad available nahi hai. Dobara try karein.";
  } finally {
    translating = false;
  }
}

// In-App Interstitial
async function showInterstitial() {
  if (typeof show_11988035 !== "function") {
    statusText.textContent = "Ad SDK load nahi hua.";
    return;
  }

  try {
    await show_11988035({
      type: "inApp",
      inAppSettings: {
        frequency: 2,
        capping: 0.1,
        interval: 30,
        timeout: 5,
        everyPage: false
      }
    });
    statusText.textContent = "Interstitial ad flow finished.";
  } catch (error) {
    console.error(error);
    statusText.textContent = "Interstitial ad unavailable.";
  }
}

// Rewarded Popup
async function showRewardedPopup() {
  if (typeof show_11988035 !== "function") {
    statusText.textContent = "Ad SDK load nahi hua.";
    return;
  }

  try {
    await show_11988035("pop");
    statusText.textContent = "Rewarded popup flow finished.";
    // Secure verification ke bina coins ya reward na dein.
  } catch (error) {
    console.error(error);
    statusText.textContent = "Popup ad unavailable.";
  }
}

// Translation
async function translateText() {
  const text = input.value.trim();

  if (!text) {
    alert("Please enter some text");
    return;
  }

  if (from.value === to.value) {
    result.textContent = text;
    statusText.textContent = "Translation complete ✓";
    return;
  }

  statusText.textContent = "Translating...";

  try {
    const url =
      "https://api.mymemory.translated.net/get?q=" +
      encodeURIComponent(text) +
      "&langpair=" + from.value + "|" + to.value;

    const response = await fetch(url);

    if (!response.ok) {
      throw new Error("Network error");
    }

    const data = await response.json();

    if (!data.responseData ||
        !data.responseData.translatedText) {
      throw new Error("Translation failed");
    }

    result.textContent = data.responseData.translatedText;
    statusText.textContent = "Translation complete ✓";
  } catch (error) {
    console.error(error);
    result.textContent =
      "Translation failed. Check your internet connection.";
    statusText.textContent = "";
  }
}

function swapLang() {
  const oldFrom = from.value;
  from.value = to.value;
  to.value = oldFrom;

  if (input.value.trim()) {
    translateText();
  }
}

function clearText() {
  input.value = "";
  result.textContent = "Your translation will appear here...";
  statusText.textContent = "";
}

async function copyText() {
  const text = result.textContent;

  if (!text || text === "Your translation will appear here...") {
    return;
  }

  try {
    await navigator.clipboard.writeText(text);
    statusText.textContent = "Copied ✓";
  } catch (error) {
    statusText.textContent = "Copy failed. Please copy manually.";
  }
}

function speakText() {
  const text = result.textContent;

  if (!text || text === "Your translation will appear here...") {
    return;
  }

  if (!("speechSynthesis" in window)) {
    alert("Text to speech is not supported");
    return;
  }

  const speech = new SpeechSynthesisUtterance(text);
  speech.lang = getSpeechLanguage(to.value);
  speechSynthesis.cancel();
  speechSynthesis.speak(speech);
}

function getSpeechLanguage(lang) {
  const languages = {
    en: "en-US", hi: "hi-IN", ar: "ar-SA",
    es: "es-ES", fr: "fr-FR", de: "de-DE",
    it: "it-IT", pt: "pt-BR", ru: "ru-RU",
    ja: "ja-JP", ko: "ko-KR", zh: "zh-CN"
  };

  return languages[lang] || "en-US";
}

function startMic() {
  const SpeechRecognition =
    window.SpeechRecognition || window.webkitSpeechRecognition;

  if (!SpeechRecognition) {
    alert("Speech recognition is not supported. Use Chrome on Android.");
    return;
  }

  const recognition = new SpeechRecognition();
  recognition.lang = getSpeechLanguage(from.value);
  recognition.interimResults = false;
  recognition.continuous = false;

  statusText.textContent = "Listening... 🎤";

  recognition.onresult = function(event) {
    input.value = event.results[0][0].transcript;
    statusText.textContent = "Voice received ✓";
    translateWithAd();
  };

  recognition.onerror = function(event) {
    console.log(event.error);
    statusText.textContent = "Microphone error";
  };

  recognition.onend = function() {
    if (statusText.textContent === "Listening... 🎤") {
      statusText.textContent = "";
    }
  };

  recognition.start();
}

function focusText() {
  input.focus();
}

document.getElementById("search").addEventListener("input", function() {
  const value = this.value.toLowerCase();

  [...from.options].forEach(option => {
    option.hidden = !option.text.toLowerCase().includes(value);
  });

  [...to.options].forEach(option => {
    option.hidden = !option.text.toLowerCase().includes(value);
  });
});
</script>

</body>
</html>
